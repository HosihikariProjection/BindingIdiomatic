<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Hosihikari.Binding.LeviLamina</RootNamespace>
    <AssemblyName>Hosihikari.Binding.LeviLamina</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- A generated member marked [Obsolete] is a stub. Wrapping one would put a
         NotSupportedException behind an idiomatic signature, so it is an error here. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS0618</WarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Hosihikari.Binding.LeviLamina</PackageId>
    <Version>26.60.2-r0</Version>
    <Authors>Hosihikari</Authors>
    <Description>Hand-written .NET Idiomatic layer over the LeviLamina Interop surface.</Description>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/HosihikariProjection/BindingIdiomatic</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>minecraft;bedrock;bds;levilamina;hosihikari;idiomatic</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Hosihikari.Binding/Hosihikari.Binding.csproj" />
    <!-- ADR-0027: the pair is released together, so the packed dependency is an exact
         range on the Interop this package was built against. -->
    <ProjectReference Include="$(LeviLaminaInteropProjectPath)"
                      Condition="'$(LeviLaminaInteropProjectPath)' != ''"
                      Version="[26.60.2-r0]" />
    <ProjectReference Include="../../../Binding.LeviLamina/src/Hosihikari.Bindings.LeviLamina.Interop/Hosihikari.Bindings.LeviLamina.Interop.csproj"
                      Condition="'$(LeviLaminaInteropProjectPath)' == ''"
                      Version="[26.60.2-r0]" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
